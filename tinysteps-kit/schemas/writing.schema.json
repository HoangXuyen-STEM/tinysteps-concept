{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TinySteps Writing Practice Document",
  "type": "object",
  "required": ["level", "total_exercises", "exercises"],
  "properties": {
    "level": { "type": "string", "enum": ["starters", "movers", "flyers", "ket", "pet"] },
    "total_exercises": { "type": "integer", "const": 5 },
    "exercises": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "level", "order", "title", "scenario", "estimated_minutes", "grammar_ids", "instruction", "passage", "blanks"],
        "properties": {
          "id": { "type": "string", "pattern": "^(starters|movers|flyers|ket|pet)_writing_\\d{3}$" },
          "level": { "type": "string", "enum": ["starters", "movers", "flyers", "ket", "pet"] },
          "order": { "type": "integer", "minimum": 1, "maximum": 5 },
          "title": { "type": "string" },
          "scenario": { "type": "string" },
          "estimated_minutes": { "type": "integer", "minimum": 3, "maximum": 15 },
          "grammar_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "instruction": { "type": "string" },
          "passage": { "type": "string", "description": "Use {{blank_id}} placeholders." },
          "blanks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "cue", "accepted_answers"],
              "properties": {
                "id": { "type": "string", "pattern": "^b\\d+$" },
                "cue": { "type": "string", "minLength": 1 },
                "accepted_answers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
              }
            }
          }
        }
      }
    }
  }
}
