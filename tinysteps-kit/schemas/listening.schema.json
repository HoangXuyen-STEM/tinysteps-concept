{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TinySteps Listening Practice Document",
  "type": "object",
  "required": ["level", "total_exercises", "exercises"],
  "properties": {
    "level": { "type": "string", "enum": ["starters", "movers", "flyers", "ket", "pet"] },
    "total_exercises": { "type": "integer", "const": 3 },
    "exercises": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "level",
          "order",
          "title",
          "scenario",
          "estimated_minutes",
          "grammar_ids",
          "instruction",
          "audio_text",
          "passage",
          "transcript",
          "blanks"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^(starters|movers|flyers|ket|pet)_listening_\\d{3}$" },
          "level": { "type": "string", "enum": ["starters", "movers", "flyers", "ket", "pet"] },
          "order": { "type": "integer", "minimum": 1, "maximum": 3 },
          "title": { "type": "string" },
          "scenario": { "type": "string" },
          "estimated_minutes": { "type": "integer", "minimum": 3, "maximum": 15 },
          "grammar_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "instruction": { "type": "string" },
          "audio_text": {
            "type": "string",
            "description": "Full spoken script (answers filled in), TTS-friendly. Server-only — never sent to the client."
          },
          "passage": { "type": "string", "description": "Gapped text shown to the learner. Use {{blank_id}} placeholders." },
          "transcript": {
            "type": "string",
            "description": "Full text with answers filled in, shown to the learner only AFTER they submit."
          },
          "blanks": {
            "type": "array",
            "minItems": 5,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": ["id", "cue", "category", "accepted_answers"],
              "properties": {
                "id": { "type": "string", "pattern": "^b\\d+$" },
                "cue": { "type": "string", "minLength": 1 },
                "category": {
                  "type": "string",
                  "enum": ["number", "color", "address", "age"],
                  "description": "Vocabulary focus for this blank."
                },
                "accepted_answers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
              }
            }
          }
        }
      }
    }
  }
}
