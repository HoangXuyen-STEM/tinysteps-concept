# Audio CDN base (empty in dev → served from /public; Supabase Storage URL in prod, phase 07).
# Prod value = "https://<ref>.supabase.co/storage/v1/object/public" — NO trailing "/audio"
# (the manifest's own paths already start with "audio/"; see lib/content/audio-manifest.ts).
NEXT_PUBLIC_AUDIO_BASE_URL=

# Match illustration CDN base. Use the same Storage public root convention as audio:
# "https://<ref>.supabase.co/storage/v1/object/public" — NO trailing "/illustrations".
NEXT_PUBLIC_ASSET_BASE_URL=

# Supabase project (dashboard → Project Settings → API). Owned by the user.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL for magic-link redirects (prod Vercel domain; leave empty in dev to use request origin)
NEXT_PUBLIC_SITE_URL=

# Pilot feedback Google Form (decision 6, plan.md). Nav link is hidden when unset.
NEXT_PUBLIC_FEEDBACK_FORM_URL=

# --- Purchase flow (manual bank transfer) ---
# Bank code recognised by VietQR, e.g. "VCB", "TCB", "MB", "ACB", "BIDV".
# The purchase page falls back to a "contact me directly" message when any of the
# three bank values below is empty, so an unconfigured deploy never shows a broken QR.
NEXT_PUBLIC_BANK_CODE=
NEXT_PUBLIC_BANK_ACCOUNT=
NEXT_PUBLIC_BANK_HOLDER=

# Where buyers reach you to confirm a transfer (Zalo / Messenger link).
NEXT_PUBLIC_CONTACT_URL=
NEXT_PUBLIC_CONTACT_LABEL=

# "early_bird" (default) charges the launch price; set to "standard" once the
# early-bird seats are gone to charge full price without a redeploy of code.
NEXT_PUBLIC_OFFER_STAGE=early_bird

# --- Internal admin dashboard (/admin) ---
# SERVER-ONLY. Never prefix these with NEXT_PUBLIC_ — they must not reach the browser.
#
# Comma-separated allow-list of admin/owner emails permitted to open /admin. Anyone whose
# signed-in email is not listed gets a 404. Leave empty and /admin 404s for everyone.
ADMIN_EMAILS=

# Supabase service-role key (dashboard → Project Settings → API → service_role secret).
# Grants full DB access, bypassing RLS — treat like a root password. Used only by
# server-side admin code to grant/revoke paid access. If unset, /admin shows a safe
# configuration notice to admins and performs no mutations. NEVER commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
