        "text": "Of course. Here is today's price list."
      },
      {
        "character_id": "char_a",
        "text": "The price for organic vegetables is quite high."
      },
      {
        "character_id": "char_b",
        "text": "I apologise, but the quality is excellent."
      },
      {
        "character_id": "char_a",
        "text": "I always bargain at the market. Can we negotiate?"
      },
      {
        "character_id": "char_b",
        "text": "If you buy five kilos, I will give you a ten percent discount."
      },
      {
        "character_id": "char_a",
        "text": "That sounds fair. I will take five kilos."
      },
      {
        "character_id": "char_b",
        "text": "Thank you. Here is your bill and your change."
      }
