    "lines": [
      {
        "character_id": "char_a",
        "text": "Good morning. I have a terrible headache and a high fever."
      },
      {
        "character_id": "char_b",
        "text": "I am sorry to hear that. How long have you had these symptoms?"
      },
      {
        "character_id": "char_a",
        "text": "The fever started two days ago and has not improved."
      },
      {
        "character_id": "char_b",
        "text": "I see. I will write a prescription for you."
      },
      {
        "character_id": "char_a",
        "text": "Should I describe any other symptoms?"
      },
      {
        "character_id": "char_b",
        "text": "Yes, do you have a sore throat or difficulty breathing?"
      },
      {
        "character_id": "char_a",
        "text": "No, just the headache and fever."
      },
      {
        "character_id": "char_b",
        "text": "Please take the medicine after meals and rest completely."
      }
    ]
  },
