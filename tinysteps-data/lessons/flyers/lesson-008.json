        "character_id": "char_a",
        "text": "I understand. The quality makes up for it."
      },
      {
        "character_id": "char_b",
        "text": "If you sign up for our membership, you will receive a discount."
      },
      {
        "character_id": "char_a",
        "text": "That sounds worthwhile. I often dine here."
      },
      {
        "character_id": "char_b",
        "text": "Wonderful. I will bring you the application form."
