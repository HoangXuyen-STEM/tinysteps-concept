  "grammar_points": [
    {
      "id": "movers_grammar_001",
      "name": "present_continuous",
      "pattern": "Subject + am/is/are + Verb-ing",
      "topic_ids": [
        "topic_in_class",
        "topic_before_class"
      ],
      "examples": [
        {
          "sentence": "I am writing in my book.",
          "context": "describing classroom action"
        },
        {
          "sentence": "He is cleaning the board.",
          "context": "student helping teacher"
        },
        {
          "sentence": "They are listening to the teacher.",
          "context": "monitoring class activity"
        },
        {
          "sentence": "What are you doing?",
          "context": "checking on a student"
        },
        {
          "sentence": "The students are doing homework.",
          "context": "monitoring work"
        }
      ],
      "common_mistakes": [
        {
          "wrong": "I writing my book.",
          "correct": "I am writing in my book."
        },
        {
          "wrong": "He is write on the board.",
          "correct": "He is writing on the board."
        }
      ],
      "builds_on": [
        "starters_grammar_003"
      ]
    },
    {
