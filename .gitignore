# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
dist/
bin/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# package manager
package-lock.json
yarn.lock
pnpm-lock.yaml
!tinysteps-app/package-lock.json

# semantic-release
.nyc_output

# env files (can opt-in for committing if needed)
.env*
!.env.example
!tinysteps-app/.env.local.example
*.swp
*.swo
recovery-codes.txt
github-recovery-codes.txt
.venv/

# vercel
.vercel
.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts

# flutter
.dart_tool
build
GoogleService-Info.plist

repomix-output.xml
.serena/cache
plans/**/*
!plans/templates/*
screenshots/*
docs/screenshots/*
logs.txt
test-ck
__pycache__
tinysteps-data/audio/**/*.mp3
tinysteps-app/public/audio

# Match illustrations: generated WebPs go to Storage (like audio), not git. The queue/
# batch JSON is derived+ephemeral (depends on local disk state — regenerate anytime via
# generate_match_illustration_queue.py). QA reports (source of truth for what's
# approved) and the built manifest.json ARE tracked, same as audio's manifest.json.
tinysteps-app/public/illustrations/**/*.webp
tinysteps-data/match-illustration-queue.json
tinysteps-data/match-illustration-batches/

# CK meta commands
prompt.md
ck.md

# Generated runtime layout for release/install smoke tests
/.claude/
# But track repo-level rules that Claude Code reads
!/.claude/rules/

# Local-only state inside tracked claude source
claude/agent-memory/
claude/hooks/.logs/
claude/session-state/latest.md
claude/session-state/archive/
claude/settings.bak.json
claude/skills/ai-multimodal/assets/demo-*.claude/session-state/*.tmp

# Gemini CLI settings (symlink to staged .claude/.mcp.json)
.gemini/settings.json
# Showoff/marketing assets (images, showcases)
assets/
# Exception: use-mcp ships a persistent tool catalog at assets/tools.json
!claude/skills/use-mcp/assets/
!claude/skills/use-mcp/assets/**

# External repos for study/reference
external/

# Git worktrees (local development only)
worktrees/

# Supabase CLI local/transient state (machine-specific, regenerated by `supabase start`)
supabase/.branches/
supabase/.temp/
